{
  "$schema": "https://tashiikid.github.io/loopweft/schema/v1.json",
  "format": "loopweft",
  "version": 1,
  "meta": {
    "title": "Global Polycrisis - The Connections That Change Everything",
    "description": "Qualitative expert-informed synthesis of supplied publications, not a calibrated causal model or quantitative risk simulation. Global/multi-scale schematic; local outcomes are context dependent."
  },
  "theme": {
    "base": "cinematic-dark",
    "fonts": {
      "heading": "Fraunces",
      "body": "Inter"
    }
  },
  "types": {
    "categories": [
      {
        "id": "earth",
        "name": "Earth systems",
        "colour": "#5ECBA9"
      },
      {
        "id": "energy",
        "name": "Energy and material systems",
        "colour": "#F2B36B"
      },
      {
        "id": "economy",
        "name": "Economy and finance",
        "colour": "#F6D36C"
      },
      {
        "id": "governance",
        "name": "Geopolitics and governance",
        "colour": "#C5A6FF"
      },
      {
        "id": "society",
        "name": "Human security and society",
        "colour": "#F0919C"
      },
      {
        "id": "technology",
        "name": "Technology and information",
        "colour": "#87C9F4"
      },
      {
        "id": "response",
        "name": "Interventions and response capacity",
        "colour": "#A5E88A"
      }
    ],
    "roles": [
      {
        "id": "stress",
        "name": "Stress",
        "shape": "rounded-square"
      },
      {
        "id": "trigger",
        "name": "Trigger",
        "shape": "circle"
      },
      {
        "id": "crisis",
        "name": "Crisis",
        "shape": "octagon"
      },
      {
        "id": "intervention",
        "name": "Response",
        "shape": "ring",
        "response": true
      }
    ],
    "linkTypes": [
      {
        "id": "common_stress",
        "name": "Common stress"
      },
      {
        "id": "cascade",
        "name": "Cascade"
      },
      {
        "id": "feedback",
        "name": "Feedback"
      },
      {
        "id": "intervention",
        "name": "Intervention"
      },
      {
        "id": "response",
        "name": "Response",
        "description": "A pressure that prompts or weakens a response inside the system (closing balancing loops)."
      },
      {
        "id": "side_effect",
        "name": "Side-effect",
        "description": "A documented possible side-effect of a response, shown only where a step names it.",
        "style": "dotted",
        "marker": "flag",
        "optional": true
      }
    ],
    "fields": [
      {
        "id": "evidence",
        "name": "Evidence",
        "kind": "choice",
        "appliesTo": "links",
        "options": [
          {
            "id": "explicit",
            "name": "Explicit",
            "description": "Pair or pathway directly described in supplied study, even when study itself is conceptual or conditional."
          },
          {
            "id": "synthesis",
            "name": "Synthesis",
            "description": "Direction constructed by combining specific claims in cited source(s)."
          },
          {
            "id": "illustrative",
            "name": "Illustrative",
            "description": "Candidate pathway worth showing but untested in supplied sources, conditional on context."
          }
        ]
      }
    ]
  },
