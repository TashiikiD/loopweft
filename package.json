{
  "name": "loopweft",
  "private": true,
  "version": "0.0.0",
  "description": "A studio for animated causal systems maps: draw the map, cite its evidence, tell its story step by step, present it and share it.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --project unit --project studio",
    "test:watch": "vitest --project unit --project studio",
    "test:e2e": "playwright test",
    "verify": "node scripts/verify.mjs",
    "verify:fast": "node scripts/verify.mjs --fast",
    "prepare": "node scripts/install-hooks.mjs",
    "site": "node scripts/build-site.mjs",
    "viewer": "vite apps/viewer",
    "player": "vite packages/player/page",
    "studio": "vite apps/studio",
    "loopweft": "node packages/cli/bin/loopweft.mjs",
    "review:capture": "node tools/capture.ts",
    "review:diff": "node tools/diff.ts",
    "review:sheets": "node tools/contact-sheet.ts",
    "schema": "node packages/model/scripts/export-schema.ts",
    "convert:polycrisis": "node packages/model/scripts/convert-polycrisis.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/d3-force": "3.0.10",
    "@types/node": "24.19.1",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fflate": "0.8.3",
    "jsdom": "30.1.1",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  }
}
