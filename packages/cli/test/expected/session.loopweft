      "to": "deaths",
      "sign": "+",
      "citations": []
    },
    {
      "id": "L4",
      "from": "deaths",
      "to": "population",
      "sign": "-",
      "citations": []
    },
    {
      "id": "L5",
      "from": "fertility",
      "to": "births",
      "sign": "+",
      "confidence": "medium",
      "citations": []
    }
  ],
