      "citations": [
        {
          "source": "test2020",
          "pages": "4–5",
          "strength": "moderate"
        }
      ]
    },
    {
      "id": "L3",
      "from": "population",
      "to": "deaths",
      "sign": "+",
      "citations": []
    },
    {
      "id": "L4",
      "from": "deaths",
      "to": "population",
      "sign": "-",
      "citations": []
    },
    {
      "id": "L5",
